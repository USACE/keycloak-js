{
  "name": "@usace/keycloak",
  "version": "2.1.0",
  "description": "A minimalist, zero-dependency, Keycloak JavaScript class to support a limited subset of authentication workflows",
  "main": "Keycloak.js",
  "repository": {
    "url": "https://github.com/USACE/keycloak-js"
  },
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run && npm run test:pkce",
    "test:coverage": "vitest --coverage",
    "test:pkce": "node --test test/*.test.mjs",
    "pub": "npm publish --access=public"
  },
  "author": "@willbreitkreutz @randal.goss",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.3"
  }
}
